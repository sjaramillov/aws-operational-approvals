{
  "name": "operational-approvals-demo",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --mode demo --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:runtime-config": "node scripts/write-runtime-config.mjs --check < runtime-config.example.json",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:deployed:config": "node --test e2e/deployedConfig.test.mjs",
    "test:e2e:deployed:prepared": "playwright test --config=playwright.deployed.config.mjs",
    "test:e2e:deployed": "playwright test --config=playwright.deployed.config.mjs",
    "check": "npm run typecheck && npm run test && npm run test:e2e:deployed:config && npm run test:runtime-config && npm run build"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
